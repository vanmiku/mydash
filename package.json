{
  "name": "mydash",
  "version": "0.1.0",
  "private": true,
  "description": "A self-hosted workbench for what your coding agents (Claude Code, Codex) make: publish plans, reports, PDFs, screenshots, HTML and Office files, read them rendered on your computer or phone.",
  "license": "MIT",
  "author": "vanmiku",
  "homepage": "https://github.com/vanmiku/mydash",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/vanmiku/mydash.git"
  },
  "bugs": {
    "url": "https://github.com/vanmiku/mydash/issues"
  },
  "keywords": [
    "claude-code",
    "codex",
    "ai-agents",
    "self-hosted",
    "markdown",
    "pdf",
    "tailscale",
    "dashboard"
  ],
  "type": "module",
  "bin": {
    "mydash": "bin/mydash.mjs"
  },
  "scripts": {
    "start": "node server.mjs",
    "test": "bash test/smoke.sh && node test/i18n-check.mjs --missing-only"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "highlight.js": "^11.12.0",
    "mammoth": "^1.13.0",
    "marked": "^18.1.2",
    "mermaid": "^12.2.0",
    "pdfjs-dist": "^4.10.38",
    "qrcode-generator": "^2.0.4",
    "xlsx": "https://cdn.sheetjs.com/xlsx-0.20.3/xlsx-0.20.3.tgz"
  }
}
